# Licenciamiento del POS (Electron). El proceso main lee estas variables del
# entorno del sistema (en dev: del shell; en producción: del servicio/instalador).

# URL del servicio de licencias. En producción, si se deja vacío, se usa
# https://licencias-api.prismapos.site por defecto (no hace falta instalarla).
LICENSING_SERVER_URL=https://licencias-api.prismapos.site
LICENSING_CLIENT_CODE=CLIENTE
STORE_NAME=Tienda
STORE_ID=001
POS_NO=1
LICENSING_POLL_MS=10000
LICENSING_ENROLL_MAX_ATTEMPTS=0
